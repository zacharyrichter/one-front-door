# Environment for the Authentik stack. Names only; every value is a placeholder.
# Used by the server and worker containers; the POSTGRES_* lines are for the database container.

AUTHENTIK_SECRET_KEY=change-me-long-random-string

AUTHENTIK_POSTGRESQL__HOST=authentik-postgres
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=change-me

# Mail is for password reset only. Implicit TLS on 465: USE_SSL true, USE_TLS false.
# (USE_TLS means STARTTLS, which belongs on port 587.)
AUTHENTIK_EMAIL__HOST=smtp.example.net
AUTHENTIK_EMAIL__PORT=465
AUTHENTIK_EMAIL__USERNAME=authentik@mg.example.net
AUTHENTIK_EMAIL__PASSWORD=change-me
AUTHENTIK_EMAIL__USE_SSL=true
AUTHENTIK_EMAIL__USE_TLS=false
AUTHENTIK_EMAIL__TIMEOUT=10
# The sender must be a full address on the relay's sending domain.
AUTHENTIK_EMAIL__FROM=authentik@mg.example.net

AUTHENTIK_ERROR_REPORTING__ENABLED=false

POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=change-me
